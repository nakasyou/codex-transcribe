{
  "name": "@nakasyou/ntranscribe",
  "version": "0.1.0",
  "description": "Transcribe audio with Codex or Chrome speech recognition",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakasyou/ntransctibe.git"
  },
  "bin": {
    "ntranscribe": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "start": "bun src/index.ts",
    "build": "vp pack",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt . --write",
    "format": "vp fmt . --write",
    "test": "bun test",
    "prepublishOnly": "bun run check && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "5.9.3",
    "vite-plus": "^1.0.0"
